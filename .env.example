DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Blank uses the current WM31 configured guild.
DISCORD_GUILD_ID=
DISCORD_GATEWAY_DISABLED=false
MINISAGO_CHATBOT_OWNER_USER_ID=123456789012345678
MINISAGO_CHATBOT_GUILD_IDS=123456789012345678
MINISAGO_CHATBOT_CHANNEL_IDS=
# Opt in after observing the bot in the configured guilds/channels.
MINISAGO_AMBIENT_REACTIONS_ENABLED=false
# Chance that an eligible notification burst makes MiniSago check Discord.
MINISAGO_AMBIENT_ATTENTION_CHANCE=0.25
# Hard model-call ceiling for ambient attention; mentions are separate.
MINISAGO_AMBIENT_MAX_CHECKS_PER_HOUR=4
# Persistent one-time and cron reminder state.
MINISAGO_REMINDER_STATE_FILE=.data/reminders.json
# Shared with production; use a random 32-byte-or-longer value.
MINISAGO_MAC_BRIDGE_SECRET=
# Server-only secret for the unified Oracle worker.
MINISAGO_WORKER_BRIDGE_SECRET=
MINISAGO_BRIDGE_URL=wss://bot.hsichen.dev/api/mac-agent/ws
# Blank derives https://.../api/chatbot/mcp from MINISAGO_BRIDGE_URL.
MINISAGO_MCP_URL=
MINISAGO_CODEX_PATH=/Applications/ChatGPT.app/Contents/Resources/codex
MINISAGO_MAX_CONCURRENT_JOBS=2
MINISAGO_WORKER_ID=hsi-mac
# Colon-separated folders MiniSago may search and send from. Blank uses common user folders and iCloud Drive.
MINISAGO_MAC_FILE_ROOTS=
MINISAGO_GITHUB_REPOSITORIES=owner/repository
MINISAGO_CHATBOT_REPOSITORY=owner/repository
MINISAGO_GITHUB_CONFIG_DIR=
MINISAGO_GITHUB_WORKTREE_ROOT=
DISCORD_CHANNEL_ACCESS_CHANNEL_ID=
TOEFL_VOCAB_CHANNEL_ID=
TOEFL_VOCAB_TIME=08:00
TOEFL_VOCAB_TIMEZONE=Asia/Taipei
GAMER_FORUM_CHANNEL_ID=1518127531968958558
GAMER_FORUM_URL=https://m.gamer.com.tw/forum/C.php?bsn=36476&snA=3047&to=112
GAMER_FORUM_CHECK_TIMES=08:30,20:30
GAMER_FORUM_TIMEZONE=Asia/Taipei
GAMER_FORUM_READER_BASE_URL=https://r.jina.ai/
X_POST_HANDLE=thsottiaux
X_POST_CHANNEL_ID=1527893157168283668
X_POST_CHECK_INTERVAL_MS=300000
GITHUB_WEBHOOK_SECRET=
GITHUB_PR_THREAD_CHANNEL_ID=1521506395034226830
# Blank uses the WM31 Wordle and Brawl Stars roles documented in docs/configuration.md.
SELF_ASSIGNABLE_ROLES=
